{
  "headers": [
    {
      "source": "/audio/pinyin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/content/course",
      "destination": "/api/content"
    },
    {
      "source": "/api/content/lessons",
      "destination": "/api/content"
    },
    {
      "source": "/api/content/pinyin/course",
      "destination": "/api/content"
    },
    {
      "source": "/api/admin/content/lessons",
      "destination": "/api/admin/content"
    },
    {
      "source": "/api/admin/content/draft",
      "destination": "/api/admin/content"
    },
    {
      "source": "/api/admin/content/publish",
      "destination": "/api/admin/content"
    },
    {
      "source": "/api/admin/content/rollback",
      "destination": "/api/admin/content"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
